generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Product {
  id             Int      @id @default(autoincrement())
  proName        String
  proPrice       Decimal  @db.Decimal(10, 2)
  proQuantity    Int      @default(0)
  proDescription String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
